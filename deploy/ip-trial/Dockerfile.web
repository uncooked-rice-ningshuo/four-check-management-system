# Static assets are architecture-independent; run checks natively on the build host.
FROM --platform=$BUILDPLATFORM registry-1.docker.io/library/node:24.12.0-alpine AS build
RUN corepack enable
WORKDIR /app
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ .
COPY server/internal/inspection/catalog.json /server/internal/inspection/catalog.json
# Tests are run separately before release; image creation only emits production assets.
RUN pnpm build
FROM registry-1.docker.io/library/nginx:1.27-alpine
COPY deploy/ip-trial/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
EXPOSE 80
