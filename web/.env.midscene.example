# Copy this file to .env.midscene.local and fill in your OpenAI API key.
# Keep credentials out of version control.
MIDSCENE_MODEL_BASE_URL=https://api.openai.com/v1
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=gpt-6-luna
MIDSCENE_MODEL_FAMILY=gpt-6
MIDSCENE_MODEL_PROTOCOL=openai-responses

# Optional: point tests at a disposable, already-running app instead of starting Vite.
# MIDSCENE_BASE_URL=http://127.0.0.1:8088
