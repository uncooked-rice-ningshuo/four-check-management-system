# Static assets are architecture-independent; run checks natively on the build host.
FROM --platform=$BUILDPLATFORM registry-1.docker.io/library/node:24.12.0-alpine AS build
RUN corepack enable
WORKDIR /app
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ .
COPY 页面使用素材/ ../页面使用素材/
COPY server/internal/inspection/catalog.json /server/internal/inspection/catalog.json
RUN pnpm lint && pnpm test && pnpm build
FROM registry-1.docker.io/library/nginx:1.27-alpine
COPY deploy/ip-trial/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
